    private boolean setupGame() {
        Map<String, Integer> loadedScores = FileHandler.loadScores();

        String p1Name = JOptionPane.showInputDialog(this, "Enter Your Name (Player 1):", "👤  Player 1 Setup", JOptionPane.PLAIN_MESSAGE);
        if (p1Name == null || p1Name.trim().isEmpty()) return false;
        player1 = new HumanPlayer(p1Name.trim(), 'X');
        player1.setScore(loadedScores.getOrDefault(player1.getName(), 0));

        String[] modes = {"🤖  Player vs Computer", "👥  Player vs Player"};
        int mode = JOptionPane.showOptionDialog(this, "Choose Game Mode", "⚙  Game Mode",
                JOptionPane.DEFAULT_OPTION, JOptionPane.QUESTION_MESSAGE, null, modes, modes[0]);

        if (mode == 0) {
            String[] levels = {"😊  Easy", "😈  Hard"};
            int lvl = JOptionPane.showOptionDialog(this, "Choose Difficulty", "🎯  Difficulty",
                    JOptionPane.DEFAULT_OPTION, JOptionPane.QUESTION_MESSAGE, null, levels, levels[0]);
            player2 = new ComputerPlayer('O', lvl == 0 ? 1 : 2);
        } else if (mode == 1) {
            String p2Name = JOptionPane.showInputDialog(this, "Enter Player 2's Name:", "👤  Player 2 Setup", JOptionPane.PLAIN_MESSAGE);
            if (p2Name == null || p2Name.trim().isEmpty()) return false;
            player2 = new HumanPlayer(p2Name.trim(), 'O');
        } else return false;

        player2.setScore(loadedScores.getOrDefault(player2.getName(), 0));
        return true;
    }

