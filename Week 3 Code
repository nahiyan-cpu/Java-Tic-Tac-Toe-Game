    class GameButton extends JButton {
        private char symbol = '_';
        private boolean highlight = false;
        private boolean hovered = false;

        GameButton() {
            setOpaque(false);
            setContentAreaFilled(false);
            setBorderPainted(false);
            setFocusPainted(false);
            setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
            setPreferredSize(new Dimension(130, 130));

            addMouseListener(new MouseAdapter() {
                public void mouseEntered(MouseEvent e) { hovered = true;  repaint(); }
                public void mouseExited(MouseEvent e)  { hovered = false; repaint(); }
            });
        }

        void setSymbol(char s) { this.symbol = s; repaint(); }
        void setHighlight(boolean h) { this.highlight = h; repaint(); }
        void reset() { symbol = '_'; highlight = false; hovered = false; setEnabled(true); repaint(); }

        @Override
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int w = getWidth(), h = getHeight();
            int arc = 18;

            
            Color bg = highlight ? COLOR_WIN_BG : (hovered && symbol == '_') ? COLOR_BTN_HOV : COLOR_BTN_BG;
            g2.setColor(bg);
            g2.fillRoundRect(0, 0, w, h, arc, arc);

            
            Color borderColor = highlight ? COLOR_ACCENT : (hovered && symbol == '_') ? COLOR_ACCENT : new Color(50, 50, 75);
            g2.setColor(borderColor);
            g2.setStroke(new BasicStroke(highlight ? 2.5f : 1.5f));
            g2.drawRoundRect(1, 1, w - 2, h - 2, arc, arc);

            
            int pad = 28;
            if (symbol == 'X') {
                g2.setColor(COLOR_X);
                g2.setStroke(new BasicStroke(6f, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
                g2.drawLine(pad, pad, w - pad, h - pad);
                g2.drawLine(w - pad, pad, pad, h - pad);
            } else if (symbol == 'O') {
                g2.setColor(COLOR_O);
                g2.setStroke(new BasicStroke(6f, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
                g2.drawOval(pad, pad, w - pad * 2, h - pad * 2);
            }

            g2.dispose();
        }
    }

    

