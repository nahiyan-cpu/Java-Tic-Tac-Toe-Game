class Board {
    private final char[] board = new char[9];
    private static final int[][] LINES = {
        {0,1,2},{3,4,5},{6,7,8},
        {0,3,6},{1,4,7},{2,5,8},
        {0,4,8},{2,4,6}
    };

    public Board() { for (int i = 0; i < 9; i++) board[i] = '_'; }
    public boolean isMoveValid(int i) { return i >= 0 && i < 9 && board[i] == '_'; }
    public void placeMove(int i, char s) { if (isMoveValid(i)) board[i] = s; }
    public boolean isFull() { for (char c : board) if (c == '_') return false; return true; }

    public boolean checkWinner(char s) { return getWinningCombo(s) != null; }

    public int[] getWinningCombo(char s) {
        for (int[] line : LINES)
            if (board[line[0]] == s && board[line[1]] == s && board[line[2]] == s)
                return line;
        return null;
    }

    public char[] getBoardState() { return board.clone(); }
}


abstract class Player {
    protected String name; protected char symbol; protected int score;
    public Player(String n, char s) { name = n; symbol = s; score = 0; }
    public String getName()    { return name; }
    public char   getSymbol()  { return symbol; }
    public int    getScore()   { return score; }
    public void   setScore(int s) { score = s; }
    public void   incrementScore() { score++; }
    public abstract int makeMove(Board board);
}

class HumanPlayer extends Player {
    public HumanPlayer(String n, char s) { super(n, s); }
    @Override public int makeMove(Board b) { return -1; }
}

class ComputerPlayer extends Player {
    private final Random random = new Random();
    private final int level;
    public ComputerPlayer(char s, int lvl) { super("Computer", s); level = lvl; }

    @Override public int makeMove(Board board) {
        if (level == 2) { int m = findBestMove(board); if (m != -1) return m; }
        return findRandomMove(board);
    }
    private int findRandomMove(Board b) {
        int i; do { i = random.nextInt(9); } while (!b.isMoveValid(i)); return i;
    }
    private int findBestMove(Board b) {
        int win  = findWinOrBlock(b, this.symbol);           if (win  != -1) return win;
        char opp = (symbol == 'X') ? 'O' : 'X';
        int block = findWinOrBlock(b, opp);                  if (block != -1) return block;
        if (b.isMoveValid(4)) return 4;
        return -1;
    }
    private int findWinOrBlock(Board b, char s) {
        char[] state = b.getBoardState();
        for (int i = 0; i < 9; i++) {
            if (b.isMoveValid(i)) {
                Board tmp = new Board();
                for (int j = 0; j < 9; j++) tmp.placeMove(j, state[j]);
                tmp.placeMove(i, s);
                if (tmp.checkWinner(s)) return i;
            }
        }
        return -1;
    }
}


class FileHandler {
    private static final String SCORE_FILE   = "scores.txt";
    private static final String HISTORY_FILE = "game_history.log";

    public static Map<String, Integer> loadScores() {
        Map<String, Integer> m = new HashMap<>();
        try (BufferedReader r = new BufferedReader(new FileReader(SCORE_FILE))) {
            String line;
            while ((line = r.readLine()) != null) {
                String[] p = line.split(":");
                if (p.length == 2) m.put(p[0], Integer.parseInt(p[1]));
            }
        } catch (IOException ignored) {}
        return m;
    }

    public static void saveScores(Map<String, Integer> scores) {
        try (PrintWriter w = new PrintWriter(new FileWriter(SCORE_FILE))) {
            for (Map.Entry<String, Integer> e : scores.entrySet())
                w.println(e.getKey() + ":" + e.getValue());
        } catch (IOException e) { e.printStackTrace(); }
    }

    public static void logGameHistory(String p1, String p2, String winner) {
        try (PrintWriter w = new PrintWriter(new FileWriter(HISTORY_FILE, true))) {
            String time = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new Date());
            w.println("[" + time + "] " + p1 + " vs " + p2 + "  →  Winner: " + winner);
        } catch (IOException e) { e.printStackTrace(); }
    }

    public static String getHistory() {
        StringBuilder sb = new StringBuilder();
        try (BufferedReader r = new BufferedReader(new FileReader(HISTORY_FILE))) {
            String line;
            while ((line = r.readLine()) != null) sb.append(line).append("\n");
        } catch (IOException e) { return "No history found."; }
        return sb.toString();
    }
