import java.util.Scanner;
import java.util.Random;

public class Practice{

// COLOR CODES
public static final String RESET="\u001B[0m";
public static final String GREEN="\u001B[32m";
public static final String RED="\u001B[31m";

public static void printboard(char[] board){

for(int i=0;i<9;i++){

char c=board[i];

if(c=='X'){
System.out.print(GREEN+" X "+RESET);
}
else if(c=='O'){
System.out.print(RED+" O "+RESET);
}
else{
System.out.print(" _ ");
}

if((i+1)%3!=0)
System.out.print("|");

if((i+1)%3==0){
System.out.println();
if(i<6)
System.out.println("-----------");
}

}

}

public static boolean checkwinner(char [] board,char sign){

if(board[0]==sign && board[1]==sign && board[2]==sign) return true;
if(board[3]==sign && board[4]==sign && board[5]==sign) return true;
if(board[6]==sign && board[7]==sign && board[8]==sign) return true;

if(board[0]==sign && board[3]==sign && board[6]==sign) return true;
if(board[1]==sign && board[4]==sign && board[7]==sign) return true;
if(board[2]==sign && board[5]==sign && board[8]==sign) return true;

if(board[0]==sign && board[4]==sign && board[8]==sign) return true;
if(board[2]==sign && board[4]==sign && board[6]==sign) return true;

return false;
}

public static void main(String[]args){

Scanner sc=new Scanner(System.in);
Random rand=new Random();

// LOGIN SYSTEM
String username="admin";
String password="1234";

System.out.println("-----Login System-----");

System.out.print("Enter Username: ");
String user=sc.next();

System.out.print("Enter Password: ");
String pass=sc.next();

if(!user.equals(username) || !pass.equals(password)){
System.out.println("Login Failed!");
return;
}

System.out.println("Login Successful!");

System.out.print("Enter Your Name: ");
String player=sc.next();

int playerScore=0;
int computerScore=0;

while(true){

char [] board={'','','','','','','','','_'};

System.out.println("-----New Game Started-----");

for(int turn=1;turn<=9;turn++){

char currentsign=(turn%2!=0)?'X':'O';

if(currentsign=='X'){

System.out.println(player+" (X) move");
System.out.print("Enter move (1-9): ");

int move=sc.nextInt();
int index=move-1;

if(move<1 || move>9 || board[index]!='_'){
System.out.println("Invalid move!");
turn--;
continue;
}

board[index]='X';
printboard(board);
}

else{

System.out.println("Computer (O) move");

int index;

do{
index=rand.nextInt(9);
}while(board[index]!='_');

board[index]='O';

printboard(board);
}

if(checkwinner(board,currentsign)){

if(currentsign=='X'){
System.out.println(player+" Wins!");
playerScore++;
}
else{
System.out.println("Computer Wins!");
computerScore++;
}

break;
}

if(turn==9){
System.out.println("Match Draw!");
}

}

// SCOREBOARD
System.out.println("-----Scoreboard-----");
System.out.println(player+" : "+playerScore);
System.out.println("Computer : "+computerScore);

// RESTART
System.out.println("Play Again? (yes/no)");
String choice=sc.next();

if(!choice.equalsIgnoreCase("yes")){
System.out.println("Logout Successful!");
break;
}

}

}

}
